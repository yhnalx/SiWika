<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SiWika" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/inset_splash</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SiWika</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">32dp</item>
        <item name="itemIconTint">@drawable/nav_item_color</item>
        <item name="itemTextColor">@drawable/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/App.CustomIndicator.Orange</item>
    </style>

    <style name="App.CustomIndicator.Orange" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/orange</item>
        <item name="android:width">60dp</item>
        <item name="android:height">40dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SiWika.Circle</item>
    </style>

    <style name="ShapeAppearance.SiWika.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

</resources>